{
  "name": "kbm-notebook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.server.json server.ts",
    "build": "next build && pnpm build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --tsconfig=tsconfig.server.json --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.30.0",
    "@hookform/resolvers": "^5.9.1",
    "@mozilla/readability": "^0.6.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "7.9.0",
    "docx": "^9.11.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
