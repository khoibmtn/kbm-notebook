# Copy to /etc/kbm-notebooklm-bridge.env (chmod 600) or export before running uvicorn.
# Required: a long random token. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=

# Listener (used by `python -m app` and the Docker image; with plain uvicorn pass --host/--port)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Browsers only: comma-separated origins allowed by CORS. Empty = no CORS headers.
# The KBM Notebook *server* calls the bridge server-to-server and does not need this.
BRIDGE_ALLOWED_ORIGINS=

# Max request body (uploads included), in MB.
BRIDGE_MAX_UPLOAD_MB=50

# notebooklm-py profile (a `notebooklm login --profile NAME` account). Empty = active/default profile.
NOTEBOOKLM_PROFILE=
# Where `notebooklm login` stored the session (default ~/.notebooklm).
# NOTEBOOKLM_HOME=

# Optional tuning
# BRIDGE_TMP_DIR=/var/tmp/kbm-bridge        # scratch space for uploads/downloads (default: system tmp)
# BRIDGE_HEALTH_TTL_SECONDS=60              # cache of the /health authentication probe
# BRIDGE_KEEPALIVE_SECONDS=600              # cookie keep-alive interval, 0 = off
